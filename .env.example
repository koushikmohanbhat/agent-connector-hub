# connector-hub settings. Copy to .env for local runs; in the cloud set these as environment variables / secrets.
# Nothing environment-specific lives in the repo.

# --- the hub ---------------------------------------------------------------------------------------------------------
HUB_AUTH=dev                      # oidc | api_key | dev (dev only with HUB_ENV=dev)
HUB_ENV=dev                       # dev | prod (prod refuses fakes and fake identities)
HUB_STORE=sqlite:///.hub/hub.db   # postgresql+psycopg://... in the cloud
# HUB_API_KEYS=                   # api_key mode: comma-separated keys for trusted agent backends
# HUB_OIDC_ISSUER=                # oidc mode
# HUB_OIDC_AUDIENCE=connector-hub
# HUB_PUBLIC_URL=                 # external base URL, for OAuth protected-resource metadata
# HUB_TOKEN_KEY=                  # HMAC key for tokenising identifiers in audit logs (stable across restarts)
# HUB_ASSERTION_KEY_FILE=         # PEM key the IdP trusts, to assert users for token exchange (api_key mode, approvals)
# HUB_ASSERTION_ISSUER=connector-hub
# HUB_LINK_KEY=                   # Fernet key, for user_oauth account linking
# HUB_ALLOWED_HOSTS=              # enable DNS-rebinding protection for these Host values

# --- Salesforce (salesforce-service) --------------------------------------------------------------------------------
# SALESFORCE_BACKEND=mcp          # mcp (the org's hosted MCP server) | rest
# SALESFORCE_MCP_URL=
# SALESFORCE_INSTANCE_URL=        # rest backend, e.g. https://<my-domain>.my.salesforce.com
# SALESFORCE_IDENTITY=token_exchange
# SALESFORCE_TOKEN_URL=
# SALESFORCE_AUDIENCE=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# --- ServiceNow (servicenow-itsm) -----------------------------------------------------------------------------------
# SERVICENOW_BACKEND=mcp          # mcp | rest
# SERVICENOW_MCP_URL=             # https://<instance>.service-now.com/sncapps/mcp-server/mcp/<server>
# SERVICENOW_INSTANCE_URL=        # https://<instance>.service-now.com
# SERVICENOW_IDENTITY=service_account
# SERVICENOW_TOKEN_URL=           # https://<instance>.service-now.com/oauth_token.do
# SERVICENOW_CLIENT_ID=
# SERVICENOW_CLIENT_SECRET=

# --- SAP S/4HANA via the AWS for SAP MCP Server (sap-s4-orders) -----------------------------------------------------
# SAP_MCP_URL=
# SAP_IDENTITY=token_exchange
# SAP_TOKEN_URL=
# SAP_CLIENT_ID=
# SAP_CLIENT_SECRET=
# SAP_RETURN_APPROVAL_LIMIT=50000

# --- Core insurance platform (insurance-core) -----------------------------------------------------------------------
# INSURANCE_CORE_URL=
# INSURANCE_CORE_IDENTITY=token_exchange
# INSURANCE_CORE_TOKEN_URL=
# CLAIM_APPROVAL_LIMIT=100000

# --- Warranty API (warranty-api, generated from OpenAPI) ------------------------------------------------------------
# WARRANTY_API_URL=
# WARRANTY_IDENTITY=service_account
